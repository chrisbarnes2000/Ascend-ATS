{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AscendRecruiterProfile",
  "description": "Recruiter profile schema for Ascend ATS",
  "type": "object",
  "required": ["recruiter_info", "organization"],
  "properties": {
    "meta": { "type": "object" },
    "recruiter_info": {
      "type": "object",
      "required": ["first_name", "last_name", "email"],
      "properties": {
        "first_name": { "type": "string" },
        "last_name": { "type": "string" },
        "title": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "linkedin": { "type": "string" },
        "avatar_url": { "type": "string" },
        "calendly_url": { "type": "string" }
      }
    },
    "organization": {
      "type": "object",
      "required": ["company_name"],
      "properties": {
        "company_name": { "type": "string" },
        "company_id": { "type": "string" },
        "website": { "type": "string" },
        "industry": { "type": "string" },
        "size": { "type": "string" },
        "description": { "type": "string" }
      }
    },
    "professional_bio": {
      "type": "object",
      "properties": {
        "summary": { "type": "string" },
        "years_experience": { "type": "number" },
        "sourcing_philosophy": { "type": "string" }
      }
    },
    "sourcing_specialties": {
      "type": "array",
      "items": { "type": "string" }
    },
    "active_focus_areas": { "type": "object" },
    "candidate_standards": { "type": "object" },
    "key_metrics": { "type": "array" }
  }
}

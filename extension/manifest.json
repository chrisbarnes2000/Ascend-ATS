{
  "manifest_version": 3,
  "name": "Ascend ATS Ingestion Bridge",
  "version": "1.0.0",
  "description": "Ingest LinkedIn and Indeed job postings directly into your Ascend ATS pipeline.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.governmentjobs.com/*",
    "http://localhost:3000/*",
    "https://ais-dev-hxvjrue22mivfrz5oy7q2w-154621295711.us-east5.run.app/*",
    "https://ais-pre-hxvjrue22mivfrz5oy7q2w-154621295711.us-east5.run.app/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.jpg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.governmentjobs.com/*",
        "http://localhost:3000/*",
        "https://ais-dev-hxvjrue22mivfrz5oy7q2w-154621295711.us-east5.run.app/*",
        "https://ais-pre-hxvjrue22mivfrz5oy7q2w-154621295711.us-east5.run.app/*"
      ],
      "exclude_globs": ["*login*", "*apply*", "*signup*", "*register*"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "128": "icon128.jpg"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://ais-dev-hxvjrue22mivfrz5oy7q2w-154621295711.us-east5.run.app https://ais-pre-hxvjrue22mivfrz5oy7q2w-154621295711.us-east5.run.app https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://apis.google.com https://www.gstatic.com;"
  }
}

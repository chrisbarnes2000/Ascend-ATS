{
  "manifest_version": 3,
  "name": "Ascend ATS Ingestion Bridge",
  "version": "1.2.6",
  "description": "Ingest LinkedIn and Indeed job postings directly into your Ascend ATS pipeline.",
  "permissions": [
    "activeTab",
    "storage",
    "contextMenus",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://*.linkedin.com/*",
    "https://*.indeed.com/*",
    "https://*.governmentjobs.com/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.workday.com/*",
    "https://*.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://*.glassdoor.com/*",
    "https://ascend-ats.ai.studio/*",
    "https://*.ai.studio/*",
    "https://*.run.app/*",
    "http://localhost:*/*",
    "https://localhost:*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.linkedin.com/*",
        "https://*.indeed.com/*",
        "https://*.governmentjobs.com/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workday.com/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.glassdoor.com/*",
        "https://ascend-ats.ai.studio/*",
        "https://*.ai.studio/*",
        "https://*.run.app/*",
        "http://localhost:*/*",
        "https://localhost:*/*"
      ],
      "exclude_globs": ["*login*", "*apply*", "*signup*", "*register*"],
      "js": [
        "modules/content/site-detector.js",
        "modules/content/scrapers.js",
        "modules/content/ingest-transport.js",
        "modules/content/overlay-modal.js",
        "modules/content/session-observer.js",
        "content.js"
      ],
      "css": ["css/tokens.css", "css/content.css"],
      "run_at": "document_idle",
      "match_origin_as_fallback": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://ascend-ats.ai.studio https://ais-dev-hxvjrue22mivfrz5oy7q2w-154621295711.us-east5.run.app https://ais-pre-hxvjrue22mivfrz5oy7q2w-154621295711.us-east5.run.app https://identitytoolkit.googleapis.com https://securetoken.googleapis.com https://firestore.googleapis.com https://apis.google.com https://www.gstatic.com;"
  }
}

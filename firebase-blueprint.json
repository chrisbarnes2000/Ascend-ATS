{
  "entities": {
    "User": {
      "title": "User",
      "description": "Base authentication and settings document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "accountType": { "type": "string", "enum": ["jobSeeker", "company", "staffingFirm"] },
        "profileCompleted": { "type": "boolean" },
        "settings": {
          "type": "object",
          "properties": {
            "autoApply": { "type": "boolean" },
            "matchThreshold": { "type": "number" },
            "notifications": { "type": "boolean" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastLogin": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "accountType", "createdAt"]
    },
    "JobSeekerProfile": {
      "title": "Job Seeker Profile",
      "description": "Detailed professional profile for job seekers",
      "type": "object",
      "properties": {
        "personalInfo": { "type": "object" },
        "professionalSummary": { "type": "string" },
        "targetRole": { "type": "string" },
        "targetSalary": { "type": "number" },
        "workExperience": { "type": "array" },
        "education": { "type": "array" },
        "skills": { "type": "array" },
        "resumes": { "type": "array" },
        "targetBenefits": { "type": "array" },
        "parsedData": { "type": "object" }
      }
    },
    "Company": {
      "title": "Company",
      "description": "Company profile and settings",
      "type": "object",
      "properties": {
        "ownerUserId": { "type": "string" },
        "name": { "type": "string" },
        "logoUrl": { "type": "string" },
        "description": { "type": "string" },
        "industry": { "type": "string" },
        "size": { "type": "string" }
      }
    },
    "Job": {
      "title": "Job Posting",
      "description": "Job advertisement details",
      "type": "object",
      "properties": {
        "companyId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "requirements": { "type": "string" },
        "parsedCriteria": { "type": "object" },
        "status": { "type": "string", "enum": ["active", "inactive", "filled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "Application": {
      "title": "Job Application",
      "description": "Records an application from a seeker to a job",
      "type": "object",
      "properties": {
        "jobId": { "type": "string" },
        "seekerId": { "type": "string" },
        "companyId": { "type": "string" },
        "status": { "type": "string", "enum": ["applied", "viewed", "interviewing", "offered", "rejected"] },
        "appliedAt": { "type": "string", "format": "date-time" },
        "method": { "type": "string", "enum": ["auto", "one-click", "manual"] },
        "communications": { "type": "array" }
      }
    },
    "StaffingInvitation": {
      "title": "Staffing Invitation",
      "description": "Onboarding token for recruiters",
      "type": "object",
      "properties": {
        "inviteCode": { "type": "string" },
        "email": { "type": "string" },
        "targetFirmName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "recruiter", "owner"] },
        "status": { "type": "string", "enum": ["pending", "accepted", "expired"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "PartnerRequest": {
      "title": "Partner Request",
      "description": "Inbound request from external sources (Dice, LinkedIn, etc.)",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "source": { "type": "string" },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "reviewed", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CompanyClaimRequest": {
      "title": "Company Claim Request",
      "description": "Request from a recruiter to be associated with a company",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "companyId": { "type": "string" },
        "companyName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "companyId", "status", "createdAt"]
    },
    "RecruiterLead": {
      "title": "Recruiter Lead",
      "description": "Inbound and mass-ingested recruiter leads for strategic outreach",
      "type": "object",
      "properties": {
        "recruiterName": { "type": "string" },
        "recruiterEmail": { "type": "string" },
        "recruiterPhone": { "type": "string" },
        "firmName": { "type": "string" },
        "clientName": { "type": "string" },
        "sourceBoard": { "type": "string" },
        "jobTitle": { "type": "string" },
        "status": { "type": "string", "enum": ["discovered", "invited", "contacted", "claimed"] },
        "discoveredByEmail": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "JobReport": {
      "title": "Job Report",
      "description": "Reports by candidates or recruiters flagging incorrect or problematic job postings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "jobId": { "type": "string" },
        "jobTitle": { "type": "string" },
        "companyName": { "type": "string" },
        "posterFirmName": { "type": "string" },
        "reporterUid": { "type": "string" },
        "reporterEmail": { "type": "string" },
        "reporterRole": { "type": "string", "enum": ["candidate", "recruiter", "admin"] },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "proposedCompanyName": { "type": "string" },
        "proposedPosterFirmName": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "resolvedAt": { "type": "string", "format": "date-time" },
        "resolvedNotes": { "type": "string" }
      },
      "required": ["jobId", "reason", "status"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "Top-level user metadata"
    },
    "users/{userId}/profiles/main": {
      "schema": "JobSeekerProfile",
      "description": "Private profile data for job seekers"
    },
    "companies/{companyId}": {
      "schema": "Company",
      "description": "Company information"
    },
    "jobs/{jobId}": {
      "schema": "Job",
      "description": "Public job postings"
    },
    "applications/{applicationId}": {
      "schema": "Application",
      "description": "Application records tracking job seeker progress"
    },
    "staffing_invitations/{inviteCode}": {
      "schema": "StaffingInvitation",
      "description": "Invitations for staffing firm recruiters"
    },
    "partner_requests/{requestId}": {
      "schema": "PartnerRequest",
      "description": "Requests from external recruiters to join the platform"
    },
    "company_claim_requests/{requestId}": {
      "schema": "CompanyClaimRequest",
      "description": "Recruiter requests to claim/link to a company"
    },
    "recruiter_leads/{leadId}": {
      "schema": "RecruiterLead",
      "description": "Auto-discovered and mass-imported recruiter leads"
    },
    "job_reports/{reportId}": {
      "schema": "JobReport",
      "description": "Discrepancy and quality reports submitted for job postings"
    }
  }
}
